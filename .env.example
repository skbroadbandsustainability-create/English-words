# Vercel 프로젝트 설정(Settings → Environment Variables)에 이 값들을 등록해주세요.
# 절대 이 파일 자체에 실제 키를 적어서 커밋하지 마세요.

# Google AI Studio(https://aistudio.google.com/app/apikey)에서 무료로 발급받을 수 있어요.
GEMINI_API_KEY=AIza...

# 기기 간 단어장 동기화용. Firebase 콘솔(https://console.firebase.google.com)에서
# 무료 프로젝트를 만들고 Realtime Database를 추가하면 나오는 "데이터베이스 URL"이에요.
# (Gemini 키 발급 때 쓴 것과 같은 구글 계정으로 로그인하면 돼요)
FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com
