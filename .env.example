# Vercel 프로젝트 설정(Settings → Environment Variables)에 이 값들을 등록해주세요.
# 절대 이 파일 자체에 실제 키를 적어서 커밋하지 마세요.

# Google AI Studio(https://aistudio.google.com/app/apikey)에서 무료로 발급받을 수 있어요.
GEMINI_API_KEY=AIza...

# 기기 간 단어장 동기화용. upstash.com에서 무료 Redis DB를 만들면
# "REST API" 섹션에서 아래 두 값을 확인할 수 있어요.
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...
